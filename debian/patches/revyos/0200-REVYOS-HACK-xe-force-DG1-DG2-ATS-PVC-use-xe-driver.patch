From 118313e98e03ea14d63faa6c59becb4fd9fc0299 Mon Sep 17 00:00:00 2001
From: Han Gao <rabenda.cn@gmail.com>
Date: Mon, 21 Jul 2025 18:33:50 +0800
Subject: [PATCH 200/200] REVYOS: HACK: xe: force DG1/DG2/ATS/PVC use xe driver

Signed-off-by: Han Gao <rabenda.cn@gmail.com>
---
 drivers/gpu/drm/xe/xe_pci.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/xe/xe_pci.c b/drivers/gpu/drm/xe/xe_pci.c
index da09c26249f5..5616718d0490 100644
--- a/drivers/gpu/drm/xe/xe_pci.c
+++ b/drivers/gpu/drm/xe/xe_pci.c
@@ -282,7 +282,7 @@ static const struct xe_device_desc dg1_desc = {
 	PLATFORM(DG1),
 	.has_display = true,
 	.has_heci_gscfi = 1,
-	.require_force_probe = true,
+	.require_force_probe = false,
 };
 
 static const u16 dg2_g10_ids[] = { XE_DG2_G10_IDS(NOP), XE_ATS_M150_IDS(NOP), 0 };
@@ -324,7 +324,7 @@ static const __maybe_unused struct xe_device_desc pvc_desc = {
 	PLATFORM(PVC),
 	.has_display = false,
 	.has_heci_gscfi = 1,
-	.require_force_probe = true,
+	.require_force_probe = false,
 };
 
 static const struct xe_device_desc mtl_desc = {
